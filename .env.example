# SDesign 开源版 — 环境变量示例
# 用法：复制为 .env，至少填一个你要用的模型的 KEY。
# 本项目无需数据库、无需登录。.env 已被 .gitignore 忽略，勿提交真实密钥。

# —— DeepSeek 官方（默认模型，建议先配这个）——
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com        # 已内置默认，一般无需改

# —— 硅基流动 SiliconFlow ——
SILICON_API_KEY=
# SILICON_BASE_URL=https://api.siliconflow.cn/v1    # 已内置默认

# —— OpenAI ——
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1         # 已内置默认

# —— MiniMax 海螺 ——
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1      # 已内置默认

# —— OpenRouter（聚合，一个 key 调多家；模型 id 用 vendor/model 形式）——
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # 已内置默认

# —— Groq（超快推理）——
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1      # 已内置默认

# —— Together AI ——
# TOGETHER_API_KEY=
# TOGETHER_BASE_URL=https://api.together.xyz/v1     # 已内置默认

# —— 其它 OpenAI 兼容网关（可选）——
# MIMO_API_KEY=
# MIMO_BASE_URL=
# LONG_CAT_API_KEY=
# LONG_CAT_BASE_URL=
