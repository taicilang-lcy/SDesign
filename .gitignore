# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files（忽略真实 .env，但放行模板 .env.example 供别人 clone 后照填）
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.antigravity/
.agents/
skills-lock.json

# IDE / 编辑器本地配置（不该进仓库）
.vscode/
.idea/
.cursor/

# 设计工作文件（app 用不到；实际 logo 在 public/sdesign-s.png）
design/
